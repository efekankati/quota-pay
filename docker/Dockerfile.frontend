# =============================================================================
# Component A: quota-web-frontend
# Multi-stage build producing an ultra-lightweight static web server (Nginx Alpine)
# =============================================================================

# Stage 1: Build the Expo Web Static Bundle
FROM node:22-alpine AS builder

WORKDIR /build

COPY package.json package-lock.json* ./
RUN npm install --legacy-peer-deps

COPY . .

ENV NODE_ENV=production
RUN npx expo export --platform web --output-dir dist --no-source-maps || npx expo export --platform web --output-dir dist
RUN find dist -name "*.map" -type f -delete 2>/dev/null || true

# Stage 2: Serve static production assets via minimal Nginx Alpine (< 25MB)
FROM nginx:1.27-alpine AS runner

COPY --from=builder /build/dist /usr/share/nginx/html

# Custom Nginx configuration supporting SPA client-side deep links (/bill/*, /pay/*)
RUN echo 'server {' > /etc/nginx/conf.d/default.conf && \
    echo '  listen 8080;' >> /etc/nginx/conf.d/default.conf && \
    echo '  server_name _;' >> /etc/nginx/conf.d/default.conf && \
    echo '  root /usr/share/nginx/html;' >> /etc/nginx/conf.d/default.conf && \
    echo '  index index.html;' >> /etc/nginx/conf.d/default.conf && \
    echo '  gzip on;' >> /etc/nginx/conf.d/default.conf && \
    echo '  gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;' >> /etc/nginx/conf.d/default.conf && \
    echo '  location / {' >> /etc/nginx/conf.d/default.conf && \
    echo '    try_files $uri $uri/ /index.html;' >> /etc/nginx/conf.d/default.conf && \
    echo '  }' >> /etc/nginx/conf.d/default.conf && \
    echo '  location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|otf|ttf|svg)$ {' >> /etc/nginx/conf.d/default.conf && \
    echo '    expires 1y;' >> /etc/nginx/conf.d/default.conf && \
    echo '    add_header Cache-Control "public, max-age=31536000, immutable";' >> /etc/nginx/conf.d/default.conf && \
    echo '  }' >> /etc/nginx/conf.d/default.conf && \
    echo '  location /healthz {' >> /etc/nginx/conf.d/default.conf && \
    echo '    access_log off;' >> /etc/nginx/conf.d/default.conf && \
    echo '    return 200 "OK\n";' >> /etc/nginx/conf.d/default.conf && \
    echo '  }' >> /etc/nginx/conf.d/default.conf && \
    echo '}' >> /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
