# =============================================================================
# Component C: quota-ingress (Caddy Reverse Proxy & SSL Termination)
# Dynamically routes /api/* to AI Proxy and all other traffic to Frontend.
# Upstreams are configurable via environment variables for hybrid placement.
# =============================================================================

{$DOMAIN_NAME::80} {
  encode zstd gzip

  # Health check endpoints wrapped in handle blocks so they run before catch-all handle
  handle /healthz {
    respond "ok" 200
  }

  handle /ingress-health {
    respond "quota-ingress OK" 200
  }

  # Static asset caching for faster frontend delivery
  @staticAssets {
    path *.js *.css *.png *.jpg *.jpeg *.webp *.svg *.woff2 *.ico
  }
  header @staticAssets Cache-Control "public, max-age=86400, immutable"

  # Route backend API calls (Receipt OCR, Token Ledger, Health)
  handle /api/* {
    reverse_proxy {$AI_PROXY_UPSTREAM:quota-ai-proxy:3000} {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  # Route all other web traffic (Static Expo Web SPA)
  handle {
    reverse_proxy {$FRONTEND_UPSTREAM:quota-web-frontend:8080} {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
