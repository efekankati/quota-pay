# =============================================================================
# Component B: quota-ai-proxy
# Dedicated Node.js 22 runtime for Gemini OCR parsing & Supabase token ledgering
# =============================================================================

# Stage 1: Compile TypeScript Server
FROM node:22-alpine AS builder

WORKDIR /build

COPY server/package.json server/package-lock.json* ./server/
COPY server/tsconfig.json ./server/
COPY server/src ./server/src

WORKDIR /build/server
RUN npm install
RUN npx tsc -p tsconfig.json
RUN npm prune --production --omit=dev

# Stage 2: Minimal Node 22 Alpine Production Runner (< 120MB)
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=512"
ENV PORT=3000
ENV AWS_REGION=eu-south-1

COPY --from=builder /build/server/package.json ./package.json
COPY --from=builder /build/server/node_modules ./node_modules
COPY --from=builder /build/server/dist ./dist

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1

CMD ["node", "--max-old-space-size=512", "dist/index.js"]
