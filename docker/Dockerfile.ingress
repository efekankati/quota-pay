# =============================================================================
# Component C: quota-ingress Dockerfile
# =============================================================================
FROM caddy:2-alpine

COPY docker/Caddyfile.ingress /etc/caddy/Caddyfile

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:80/ingress-health || exit 1

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
