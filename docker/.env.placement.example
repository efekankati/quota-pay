# =============================================================================
# Quota Pay Placement & Multi-Node Environment Template
# Dynamically interpolated by FigaroPlacementAdapter & TerraformActuator
# =============================================================================

# Active Placement Scenario: hybrid | all_edge | cloud_burst
PLACEMENT_SCENARIO=hybrid

# Upstream Targets for Quota Ingress Reverse Proxy
# In hybrid mode: AI proxy upstream points to the AWS Spot node IP/hostname
AI_PROXY_UPSTREAM=15.161.41.185:3000
FRONTEND_UPSTREAM=quota-web-frontend:8080

# Ingress & Public Domain
DOMAIN_NAME=:80

# Gemini Multimodal OCR API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Realtime & Ledger Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=

# FinOps Hard-Cap Controls
AI_MAX_BUDGET_USD=5.00
SPOT_HOURLY_RATE_USD=0.005
AWS_REGION=eu-south-1
