<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>it</string>
	<key>CFBundleDisplayName</key>
	<string>Quota</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>eu.quota.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Camera & Photos Permissions (Apple App Store & GDPR Compliant Italian / English) -->
	<key>NSCameraUsageDescription</key>
	<string>Quota necessita dell&apos;accesso alla fotocamera per eseguire l&apos;OCR dello scontrino e riconoscere automaticamente le voci del conto. / Quota requires camera access to scan physical dining receipts.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Quota accede alla libreria foto per caricare scontrini fiscali salvati in galleria. / Quota accesses photo library to import saved receipts.</string>

	<!-- Apple App Tracking Transparency (ATT) Setup -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Quota utilizza identificatori crittografati per prevenire frodi nei pagamenti e garantire l&apos;autenticità delle transazioni bancarie SEPA.</string>

	<!-- Deep Linking & Universal Links -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>eu.quota.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>quota</string>
			</array>
		</dict>
	</array>

	<!-- App Store Review Guideline 3.1.5 Compliance: Apple Pay Merchant Token API -->
	<!-- Real-world dining expense settlement, strictly exempt from In-App Purchases (IAP) -->
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>merchant.eu.quota.pay</string>
	</array>

	<!-- Satispay Scheme Query Whitelist for Deep Linking Fallback in Italy -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>satispay</string>
		<string>whatsapp</string>
		<string>tg</string>
	</array>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDarkContent</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
