# =============================================================================
# Quota Pay — Production & FinOps Environment Configuration (.env.example)
# Copy this file to `.env`. Uses AWS CLI profile `efekankati` (no raw AWS keys needed).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Metadata & Regional Settings
# -----------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_APP_NAME=Quota
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_DEFAULT_CURRENCY=EUR
EXPO_PUBLIC_DEFAULT_LOCALE=it-IT
PORT=3000

# -----------------------------------------------------------------------------
# 2. Supabase Unified Data Layer (Auth, Realtime Bill Sync, & AI Token Ledger)
# Zero extra AWS database cost — uses existing Supabase PostgreSQL + RPC
# -----------------------------------------------------------------------------
SUPABASE_URL=https://nnamvsnorjbsruwhkker.supabase.co
SUPABASE_ANON_KEY=sb_publishable_VKw5r0KvReUqf5q3lwcIjg_Fte_AMPT
SUPABASE_SERVICE_ROLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=https://nnamvsnorjbsruwhkker.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_VKw5r0KvReUqf5q3lwcIjg_Fte_AMPT

# -----------------------------------------------------------------------------
# 3. Server-Side Google Gemini AI Key (NEVER exposed to the client bundle)
# Used exclusively by `server/src/geminiProxy.ts` for `/api/ai/parse-receipt`
# and `/api/ai/translate`
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
EXPO_PUBLIC_AI_PROXY_URL=

# -----------------------------------------------------------------------------
# 4. FinOps Monetary Circuit Breaker & Budget Limits
# Soft Cap: Server returns HTTP 429 ("AI Quota Paused by Administrator")
# Hard Cap: `cost_guard.py` triggers `terraform destroy -auto-approve` ($0.00/hr)
# -----------------------------------------------------------------------------
AI_MAX_BUDGET_USD=5.00
FINOPS_HARD_CAP_USD=5.00
SPOT_HOURLY_RATE_USD=0.005

# -----------------------------------------------------------------------------
# 5. AWS & Terraform Ephemeral Spot Infrastructure (Pinned to eu-south-1 Milan)
# Authenticated via AWS CLI profile `efekankati` without static access/secret keys
# -----------------------------------------------------------------------------
AWS_PROFILE=efekankati
AWS_REGION=eu-south-1
AWS_DEFAULT_REGION=eu-south-1
DOMAIN_NAME=:80

# -----------------------------------------------------------------------------
# 6. European Payment Rails (Stripe, Apple Pay, Google Pay, Satispay, SEPA)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_PAYMENT_TEST_MODE=true
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51QuotaEuropeanDevKey00912
EXPO_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=pk_test_51QuotaEuropeanDevKey00912
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=merchant.eu.quota.pay
EXPO_PUBLIC_STRIPE_URL_SCHEME=quota
EXPO_PUBLIC_GOOGLE_PAY_ENVIRONMENT=TEST
EXPO_PUBLIC_GOOGLE_PAY_MERCHANT_ID=BCR2DN6TX7QUOTA99
EXPO_PUBLIC_GOOGLE_PAY_MERCHANT_NAME=Quota Payments EU
EXPO_PUBLIC_SATISPAY_SCHEME=satispay://
EXPO_PUBLIC_SATISPAY_BUSINESS_ID=quota_ops_it
