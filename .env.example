# Quota Mobile App - Environment Configuration Template
# TARGET: Production & Staging EU Rails (Italy, France, Germany, Spain)

# App Environment
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_APP_NAME=Quota
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_DEFAULT_CURRENCY=EUR
EXPO_PUBLIC_DEFAULT_LOCALE=it-IT

# Stripe Connect & Payments Infrastructure
# Apple Pay Merchant ID registered with Apple Developer Portal
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51QuotaEuropeanProductionKey00912
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=merchant.eu.quota.pay
EXPO_PUBLIC_STRIPE_URL_SCHEME=quota

# Google Pay Configuration (European PSD2 / SCA Compliant)
EXPO_PUBLIC_GOOGLE_PAY_ENVIRONMENT=PRODUCTION
EXPO_PUBLIC_GOOGLE_PAY_MERCHANT_ID=BCR2DN6TX7QUOTA99
EXPO_PUBLIC_GOOGLE_PAY_MERCHANT_NAME=Quota Payments EU

# Backend API Endpoints (Payouts, Webhooks, Idempotency Token Gateway)
EXPO_PUBLIC_API_BASE_URL=https://api.quota.eu/v1
EXPO_PUBLIC_DEEP_LINK_DOMAIN=quota.eu

# Satispay Integration Rails (Italy)
EXPO_PUBLIC_SATISPAY_SCHEME=satispay://
EXPO_PUBLIC_SATISPAY_BUSINESS_ID=quota_ops_it

# ML Kit OCR Settings
EXPO_PUBLIC_OCR_CONFIDENCE_THRESHOLD=0.75
EXPO_PUBLIC_AUTO_DETECT_COPERTO=true

# Google Gemini AI Vision (Multimodal Receipt Parsing)
EXPO_PUBLIC_GEMINI_API_KEY=

